{
  "modules": [
    {
      "type": "registry",
      "name": "light-painting",
      "module_id": "viam:light-painting",
      "version": "0.0.4"
    }
  ],
  "components": [
    {
      "name": "my_arm",
      "api": "rdk:component:arm",
      "model": "rdk:builtin:simulated",
      "attributes": {
        "arm-model": "xarm6",
        "speed": 1.5,
        "simulate-time": true
      },
      "frame": {
        "parent": "world",
        "translation": {
          "x": 0,
          "y": 0,
          "z": 0
        }
      }
    }
  ],
  "services": [
    {
      "name": "painting-scene",
      "api": "rdk:service:world_state_store",
      "model": "viam:light-painting:painting-scene"
    },
    {
      "name": "painter",
      "api": "rdk:service:generic",
      "model": "viam:light-painting:light-painting-controller",
      "attributes": {
        "arm": "my_arm",
        "motion_service": "builtin",
        "drawing_plane": {
          "origin": {
            "x": 300,
            "y": 150,
            "z": 500
          },
          "width_mm": 300,
          "height_mm": 300,
          "approach": {
            "x": 1,
            "y": 0,
            "z": 0
          },
          "up": {
            "x": 0,
            "y": 0,
            "z": 1
          }
        },
        "lift_mm": 50,
        "min_segment_mm": 5,
        "scene": "painting-scene"
      }
    }
  ]
}